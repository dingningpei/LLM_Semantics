                          array[int,int] of var bool: before,
                          array[int] of var int: position,
                  	      int: from, int: to,
                          array[int,int] of bool: inc, 
                          array[int,int] of bool: out, 
                          array[1..2,int] of int: endnodes,
		                      array[int,int] of int: ws,
